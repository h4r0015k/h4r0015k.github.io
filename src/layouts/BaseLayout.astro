---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
  keywords?: string[];
  navMode?: 'home' | 'notes' | 'article';
  showHomeLink?: boolean;
}

const {
  title = "Nikhil Sahani - Senior Product Engineer | Backend & Systems",
  description = "Nikhil Sahani (h4r0015k) - Senior Product Engineer with 7+ years of experience building distributed backends, system internals, and practical AI tooling.",
  canonicalUrl = "https://nikhilsahani.com/",
  ogType = "website",
  ogImage = "https://nikhilsahani.com/og-image.png",
  jsonLd,
  keywords,
  navMode = 'home',
  showHomeLink,
} = Astro.props;

const effectiveNavMode = navMode !== 'home' ? navMode : (showHomeLink ? 'article' : 'home');

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://nikhilsahani.com/#website",
      "url": "https://nikhilsahani.com/",
      "name": "Nikhil Sahani",
      "description": "Senior Product Engineer with 7+ years of experience building distributed backends, system internals, and practical AI tooling.",
      "publisher": {
        "@id": "https://nikhilsahani.com/#person"
      }
    },
    {
      "@type": "Person",
      "@id": "https://nikhilsahani.com/#person",
      "name": "Nikhil Sahani",
      "givenName": "Nikhil",
      "familyName": "Sahani",
      "alternateName": ["h4r0015k", "Nikhil Sahani (h4r0015k)"],
      "jobTitle": "Senior Product Engineer",
      "description": "Senior Product Engineer with 7+ years of experience building distributed backends, system internals, and practical AI tooling. Creator of Mountain and WhatBot.",
      "disambiguatingDescription": "Senior Product Engineer based in Thane / Mumbai with 7+ years of experience in distributed systems, backend infrastructure, and local-first software. Not affiliated with NS SiteCraft Solutions or medical practices.",
      "url": "https://nikhilsahani.com/",
      "image": "https://nikhilsahani.com/og-image.png",
      "mainEntityOfPage": "https://nikhilsahani.com/",
      "email": "hire@nikhilsahani.com",
      "telephone": "+918104408291",
      "sameAs": [
        "https://github.com/h4r0015k",
        "https://www.linkedin.com/in/nikhil-sahani/"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <meta name="description" content={description}>
  <meta name="author" content="Nikhil Sahani">
  {keywords && keywords.length > 0 && (
    <meta name="keywords" content={keywords.join(', ')}>
  )}
  <link rel="canonical" href={canonicalUrl}>
  
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="Nikhil Sahani">
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Nikhil Sahani - Senior Product Engineer">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <meta name="theme-color" content="#070a08">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml">
  <link rel="ard" href="/.well-known/ard.json">
  
  <script is:inline>
    (function() {
      try {
        const params = new URLSearchParams(window.location.search);
        const urlTheme = params.get('theme');
        if (urlTheme === 'light' || urlTheme === 'dark') {
          localStorage.setItem('theme', urlTheme);
        }
      } catch (_) {}

      function getTheme() {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') return stored;
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }

      function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        const isLight = theme === 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', isLight ? '#f4f7f5' : '#070a08');
        const btn = document.getElementById('theme-toggle');
        if (btn) {
          const iconText = isLight ? '[ 0xFF ]' : '[ 0x00 ]';
          btn.textContent = iconText;
          btn.setAttribute('aria-label', `Toggle theme: ${iconText}`);
          btn.title = isLight ? 'Byte 0xFF (White): switch to 0x00 (Dark)' : 'Byte 0x00 (Black): switch to 0xFF (Light)';
        }
      }

      applyTheme(getTheme());

      document.addEventListener('DOMContentLoaded', function() {
        applyTheme(getTheme());
      });

      document.addEventListener('click', function(e) {
        const target = e.target;
        if (!target) return;
        const btn = target.closest('#theme-toggle');
        if (!btn) return;
        e.preventDefault();
        const current = document.documentElement.getAttribute('data-theme') || getTheme();
        const next = current === 'light' ? 'dark' : 'light';
        localStorage.setItem('theme', next);
        applyTheme(next);
      });

      window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function(e) {
        if (!localStorage.getItem('theme')) {
          applyTheme(e.matches ? 'light' : 'dark');
        }
      });
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Press+Start+2P&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="hud" aria-label="Navigation">
    <div class="hud-inner">
      <a href="/" class="hud-brand">~/h4r0015k</a>
      <div class="hud-ticker">
        {effectiveNavMode === 'article' && (
          <>
            <a href="/notes/" class="hud-link">[ ← ALL NOTES ]</a>
            <span>•</span>
            <a href="/" class="hud-link">[ HOME ]</a>
          </>
        )}
        {effectiveNavMode === 'notes' && (
          <>
            <a href="/" class="hud-link">[ ← HOME ]</a>
          </>
        )}
        {effectiveNavMode === 'home' && (
          <>
            <a href="/#projects" class="hud-link">[ PROJECTS ]</a>
            <span>•</span>
            <a href="/notes/" class="hud-link">[ NOTES ]</a>
            <span class="hud-contact-sep">•</span>
            <a href="/#comms" class="hud-link hud-contact">[ CONTACT ]</a>
            <span class="hud-extra">•</span>
            <a href="https://www.linkedin.com/in/nikhil-sahani/" target="_blank" rel="noopener noreferrer" class="hud-link hud-extra">[ CV ↗ ]</a>
          </>
        )}
        <span>•</span>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme: [ 0x00 ]" title="Toggle theme">[ 0x00 ]</button>
      </div>
    </div>
  </nav>

  <div class="container">
    <slot />
  </div>

  <script>
    try {
      console.log(
        '%c[SYS_INIT] Nikhil Sahani // h4r0015k%c\nSenior Product Engineer • Distributed Backends • System Internals • Applied AI\nTCP socket stream: ESTABLISHED\nDirect: hire@nikhilsahani.com | https://github.com/h4r0015k',
        'color: #00ff66; font-family: monospace; font-size: 13px; font-weight: bold; background: #070a08; padding: 2px 4px; border: 1px solid #00ff66; border-radius: 2px;',
        'color: #8fae98; font-family: monospace; font-size: 11px; line-height: 1.6;'
      );
    } catch (_) {}
  </script>
</body>
</html>
